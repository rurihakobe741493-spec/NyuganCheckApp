<%# 質問・選択肢・結果の文章はすべて仮 %>
<%
  symptoms = [
    "しこりがある",
    "乳首から液体が出る（母乳を除く）",
    "乳首がへこんだ・ただれている",
    "皮膚にくぼみやひきつれがある",
    "脇の下にしこりや腫れがある",
    "そのほか、いつもと違う変化がある"
  ]
%>

<div class="max-w-xl mx-auto p-6" data-controller="flowchart">

  <%# ============ 質問A：セルフチェック ============ %>
  <section data-flowchart-target="panel" data-panel="qa" class="hidden">
    <h2 class="text-xl mb-2">セルフチェック</h2>
    <p class="mb-4">いま気になっている乳房の変化があれば、選んでください。</p>

    <div class="space-y-2 mb-4">
      <% symptoms.each do |symptom| %>
        <label class="flex items-center gap-2">
          <input type="checkbox"
                 value="<%= symptom %>"
                 data-flowchart-target="symptom"
                 data-action="change->flowchart#clearNoSymptom">
          <span><%= symptom %></span>
        </label>
      <% end %>

      <label class="flex items-center gap-2">
        <input type="checkbox"
               data-flowchart-target="noSymptom"
               data-action="change->flowchart#clearSymptoms">
        <span>気になる変化はない</span>
      </label>
    </div>

    <button type="button"
            class="border px-4 py-2 rounded"
            data-action="click->flowchart#next">
      次へ進む
    </button>

    <%= link_to "トップページにもどる", root_path, class: "border px-4 py-2 rounded" %>

    <p data-flowchart-target="hint" class="hidden mt-2 text-sm">
      1つ以上選んでください。
    </p>
  </section>

  <%# ============ 質問B：年齢 ============ %>
  <section data-flowchart-target="panel" data-panel="qb" class="hidden">
    <h2 class="text-xl mb-2">年齢</h2>
    <p class="mb-4">現在、40歳以上ですか？　40歳未満ですか？</p>

    <div class="flex gap-3">
      <button type="button"
              class="border px-4 py-2 rounded"
              data-action="click->flowchart#choose"
              data-flowchart-next-param="result-age">
        40歳以上
      </button>
      <button type="button"
              class="border px-4 py-2 rounded"
              data-action="click->flowchart#choose"
              data-flowchart-next-param="qc">
        40歳未満
      </button>
      <button type="button"
              class="border px-4 py-2 rounded"
              data-action="click->flowchart#restart">
        最初からやり直す
      </button>
    </div>
  </section>

  <%# ============ 質問C：家族歴 ============ %>
  <section data-flowchart-target="panel" data-panel="qc" class="hidden">
    <h2 class="text-xl mb-2">家族歴</h2>
    <p class="mb-4">ご家族（血縁者）に乳がんに罹った方はいますか？</p>

    <div class="flex gap-3">
      <button type="button"
              class="border px-4 py-2 rounded"
              data-action="click->flowchart#choose"
              data-flowchart-next-param="result-family">
        はい
      </button>
      <button type="button"
              class="border px-4 py-2 rounded"
              data-action="click->flowchart#choose"
              data-flowchart-next-param="result-routine">
        いいえ
      </button>
      <button type="button"
              class="border px-4 py-2 rounded"
              data-action="click->flowchart#restart">
        最初からやり直す
      </button>
    </div>
  </section>

  <%# ============ 結果パネル ============ %>
  <section data-flowchart-target="panel" data-panel="result-symptom" class="hidden">
    <h2>乳腺外科のある医療機関を受診しましょう</h2>
    <br>
    <p>乳腺外科は乳房を専門にみる科で、マンモグラフィや超音波検査など、</p>
    <p>必要な検査へそのまま進められます。</p>
    <br>
    <p>気になる症状がある場合は、次の検診の時期に関わらず</p>
    <p>早めに受診することが大切です。</p>
    <br>
    <p>受診のときは「いつごろから」「左右どちらか」「変化しているか」を</p>
    <p>伝えられると、そのあとの検査の段取りがスムーズに進みます。</p>
    <%= render "result_actions", purpose: "treatment", qa_item: "palpation-lump" %>
  </section>
  
  <section data-flowchart-target="panel" data-panel="result-age" class="hidden">
    <h2>乳がん検診を受けましょう</h2>
    <br>
    <p>国の方針では、乳がん検診は40歳から2年に1度、マンモグラフィで受けるよう推奨されています。</p>
    <br>
    <p>症状として現れる前の、乳がんにつながる変化を見つけるための検査で、</p>
    <p>気になるところがなくても間隔をあけずに受けることに意味があります。</p>
    <br>
    <p>月経がある方は、月経前を避けて予約すると、検査時の痛みが和らぎやすくなります。</p>
    <%= render "result_actions", purpose: "screening", qa_item: "disease-age" %>
  </section>
  
  <section data-flowchart-target="panel" data-panel="result-routine" class="hidden">
    <h2>いまは、ふだんの気づきを大切に</h2>
    <br>
    <p>ふだんから自分の乳房の状態を知っておき、いつもと違うと感じたら、</p>
    <p>年齢に関係なく乳腺外科のある医療機関を受診してください。</p>
    <br>
    <p>症状がない場合でも、40歳になったら、2年に1度の乳がん検診を受けましょう。</p>
    <%= render "result_actions", purpose: "screening", qa_item: "palpation-awareness" %>
  </section>
  
  <section data-flowchart-target="panel" data-panel="result-family" class="hidden">
    <h2>乳腺外科で一度相談してみることをおすすめします</h2>
    <br>
    <p>血縁者に乳がんや卵巣がんの方がいる場合、いつから・どのくらいの間隔で</p>
    <p>検査を受けるとよいかは、一人ひとり異なります。</p>
    <br>
    <p>乳腺外科では、家族の状況を含めて相談できます。</p>
    <br>
    <p>乳がんの多くは遺伝によるものではありませんが、</p>
    <p>家族に複数の方がいる場合などは、遺伝について相談できる外来もあります。</p>
    <%= render "result_actions", purpose: "hboc", qa_item: "other-family-history" %>
  </section>
</div>
